# Crowding Approve — copy to .env.dfa and source before running curl script
# cp scripts/crowding_approve/dfa_slot_booking.env.example .env.dfa

# API base (no trailing slash)
BASE_URL=https://api.crowding-approve.example/v1

# Auth — help desk / agent session token
AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Applicant / case
USER_ID=usr_abc123
CASE_ID=

# DFA branch & process
BRANCH_ID=DFA-NCR-ASEANA
PROCESS_TYPE_ID=PASSPORT_NEW
PASSPORT_TYPE=regular
PROCESSING_TYPE=regular

# Slot target
SCHEDULE_DATE=2026-07-20
SCHEDULE_TIME=09:00
SLOT_ID=

# Booking channel: walk_in | assisted | agent
APPOINTMENT_TYPE=assisted
AGENT_ID=agent_001
STAFF_ID=ca_staff_042

# Applicant details (sent in make-a-reservation)
APPLICANT_FIRST_NAME=Juan
APPLICANT_LAST_NAME=Dela Cruz
APPLICANT_EMAIL=juan@example.com
APPLICANT_MOBILE=+639171234567
REMARKS=Agent-assisted booking via help desk

# Output folder for response JSON
OUT_DIR=/tmp/crowding_approve
