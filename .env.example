# =============================================================================
# 🔐 InsightPulse API Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# This file can be safely committed to version control

# =============================================================================
# 🤖 AI/LLM API Keys (REQUIRED)
# =============================================================================

# OpenAI API (GPT-4o, GPT-4, GPT-3.5-turbo)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic Claude API (Claude-3.5-Sonnet, Claude-3-Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-your-claude-api-key-here

# Hugging Face API Token (for your custom models: rmtariq/*)
HUGGINGFACE_API_TOKEN=hf_your-huggingface-token-here

# =============================================================================
# 🌐 Social Media Platform APIs (OPTIONAL)
# =============================================================================

# Facebook/Meta Graph API
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Instagram Basic Display API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Twitter/X API v2
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# TikTok API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=InsightPulse/1.0

# =============================================================================
# 🛒 E-commerce Platform APIs (Malaysian Focus)
# =============================================================================

# Shopee API (Malaysia)
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key
SHOPEE_ACCESS_TOKEN=your-shopee-access-token

# Lazada API (Malaysia)
LAZADA_APP_KEY=your-lazada-app-key
LAZADA_APP_SECRET=your-lazada-app-secret
LAZADA_ACCESS_TOKEN=your-lazada-access-token

# Grab API (Malaysia)
GRAB_CLIENT_ID=your-grab-client-id
GRAB_CLIENT_SECRET=your-grab-client-secret
GRAB_ACCESS_TOKEN=your-grab-access-token

# =============================================================================
# 🗞️ News & Media APIs
# =============================================================================

# News API (for Malaysian news sources)
NEWS_API_KEY=your-news-api-key

# Google News API
GOOGLE_NEWS_API_KEY=your-google-news-api-key

# =============================================================================
# 🔍 Search & Analytics APIs
# =============================================================================

# Google Custom Search API
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id

# Bing Search API
BING_SEARCH_API_KEY=your-bing-search-api-key

# =============================================================================
# 📊 Database & Storage Configuration
# =============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/insightpulse
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insightpulse
DB_USER=username
DB_PASSWORD=password

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# =============================================================================
# 🚀 Deployment Configuration
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8001

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# =============================================================================
# 🔐 Security Configuration
# =============================================================================

# JWT Secret Key (generate a secure random key)
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-this-in-production

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# 📧 Email & Notifications (Optional)
# =============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@insightpulse.com

# Slack Webhook (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# =============================================================================
# 🇲🇾 Malaysian-Specific Configuration
# =============================================================================

# Malaysian Time Zone
TIMEZONE=Asia/Kuala_Lumpur

# Default Language
DEFAULT_LANGUAGE=bahasa_malaysia

# Currency
DEFAULT_CURRENCY=MYR

# =============================================================================
# 🎯 AI Model Configuration
# =============================================================================

# Default AI Models to Use
DEFAULT_LLM_MODEL=gpt-4o
FALLBACK_LLM_MODEL=claude-3-5-sonnet-20241022
SENTIMENT_MODEL=rmtariq/ft-Malay-bert
EMOTION_MODEL=rmtariq/multilingual-emotion-classifier
CLASSIFICATION_MODEL=rmtariq/malay_claim_classifier_v2

# Model Parameters
MAX_TOKENS=4000
TEMPERATURE=0.7
TOP_P=0.9

# =============================================================================
# 📈 Analytics & Monitoring
# =============================================================================

# Google Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn-here

# =============================================================================
# 🔧 Feature Flags
# =============================================================================

# Enable/Disable Features
ENABLE_REAL_TIME_CRAWLING=true
ENABLE_AI_ANALYSIS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_TREND_DETECTION=true
ENABLE_CRISIS_DETECTION=true
ENABLE_MALAYSIAN_CONTEXT=true
