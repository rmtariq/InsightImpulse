# Enhanced InsightPulse Production Configuration
ENVIRONMENT=production
ENHANCED_FRAMEWORK_ENABLED=true

# API Configuration
API_BASE_URL=https://insightpulse-enhanced.railway.app
CORS_ORIGINS=["https://insightpulse-dashboard.netlify.app", "https://localhost:3000"]

# Database Configuration (will be updated with actual URLs)
DATABASE_URL=postgresql://postgres:password@localhost:5432/insightpulse
MONGODB_URL=mongodb://localhost:27017/insightpulse
REDIS_URL=redis://localhost:6379

# AI Model Configuration
HUGGINGFACE_TOKEN=your_token_here
MODEL_CACHE_DIR=/app/models

# Enhanced Features
CRISIS_DETECTION_ENABLED=true
REAL_TIME_PROCESSING=true
INDUSTRY_MODULES_ENABLED=true
CULTURAL_ANALYSIS_ENABLED=true

# Security
SECRET_KEY=your-super-secret-production-key-here
JWT_SECRET=your-jwt-secret-production-key-here
RATE_LIMIT_PER_MINUTE=100
MAX_QUERY_LENGTH=500

# Monitoring
PROMETHEUS_ENABLED=true
LOGGING_LEVEL=INFO
AUDIT_LOGGING=true

# Malaysian Context
MALAYSIAN_OPTIMIZATION=true
LOCAL_TIMEZONE=Asia/Kuala_Lumpur
DEFAULT_CURRENCY=MYR
