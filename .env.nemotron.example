# InsightPulse × Nemotron NIM environment.
# Copy to .env.nemotron or merge into .env on the colo box.

# NVIDIA key.
# For hosted APIs, generate at https://build.nvidia.com/
# For pulling NIM Docker images, generate at https://ngc.nvidia.com/setup/api-key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NGC_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# Persisted NIM model cache; first model pull can take 15-45 minutes.
LOCAL_NIM_CACHE=/opt/nim/cache

# Phase 1: agentic LLM (Nemotron Nano 9B)
NIM_LLM_PORT=8000
NIM_LLM_BASE_URL=http://localhost:8000/v1
NIM_LLM_API_KEY=nvapi-local-not-used
NIM_LLM_MODEL=nemotron-nano-9b
NIM_LLM_MODEL_PATH=hf://nvidia/NVIDIA-Nemotron-Nano-9B-v2
NIM_LLM_GPU=0

# Hosted NVIDIA API Catalog option for Mac / no NVIDIA GPU:
# Uncomment these lines and paste a real NVIDIA_API_KEY in .env or .env.nemotron.
# NIM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_LLM_API_KEY=${NVIDIA_API_KEY}
# NIM_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NIM_OMNI_URL=https://integrate.api.nvidia.com/v1
# NIM_OCR_URL=https://integrate.api.nvidia.com/v1
# NIM_ASR_URL=https://integrate.api.nvidia.com/v1
# NIM_OCR_MODEL=nvidia/nemotron-ocr-v2
# NIM_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NIM_ASR_MODEL=nvidia/parakeet-1.1b-rnnt-multilingual-asr
# NIM_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Phase 2: multimodal endpoints
NIM_OMNI_PORT=8002
NIM_OMNI_URL=http://localhost:8002
NIM_OMNI_MODEL=nemotron-3-nano-omni-30b-a3b-reasoning
NIM_OMNI_GPU=1

# OCR deliberately uses host 8004 because InsightPulse FastAPI owns 8001.
NIM_OCR_PORT=8004
NIM_OCR_URL=http://localhost:8004
NIM_OCR_MODEL=nemotron-ocr-v2
NIM_OCR_GPU=1

NIM_ASR_PORT=9000
NIM_ASR_GRPC_PORT=50051
NIM_ASR_URL=http://localhost:9000
NIM_ASR_GPU=1

# Phase 3: safety
NIM_SAFETY_PORT=8003
NIM_SAFETY_URL=http://localhost:8003
NIM_SAFETY_GPU=1

# Optional cloud burst for large reports.
NIM_SUPER_BASE_URL=http://localhost:8010/v1
NIM_SUPER_API_KEY=nvapi-local-not-used
NIM_SUPER_MODEL=nemotron-3-super-120b-a12b

# Optional cloud fallback for non-sensitive projects.
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# InsightPulse routing defaults. Project registry values override these.
INSIGHTPULSE_LLM_PROVIDER=on-prem-nemotron
INSIGHTPULSE_MULTIMODAL=true
REGISTRY_PATH=/Users/rmtariq/Documents/InsightPulse/data/projects/_registry.json
